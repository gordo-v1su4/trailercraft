# All secrets are server-side. Only the Vercel Functions in /api read these;
# nothing here is exposed to the browser bundle.

# ---------------------------------------------------------------------------
# LLM providers — tried in this order, first success wins.
# ---------------------------------------------------------------------------

# Primary. Kimi Code endpoint (Anthropic protocol).
# NOTE: sk-kimi-* keys only work at api.kimi.com/coding. A sk-moonshot-* platform
# key is a different product and will 401 here.
KIMI_API_KEY=
KIMI_API_URL=https://api.kimi.com/coding/v1/messages
KIMI_MODEL=kimi-k3

# Secondary. OpenAI-compatible model aggregator.
HYPER_API_KEY=
HYPER_API_URL=https://hyper.charm.land/v1/chat/completions
HYPER_MODEL=kimi-k3

# Last resort for text, and the only provider used for images and shot QC.
OPENROUTER_API_KEY=
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
# GPT Image 2.5 Sunburst. This model REJECTS /chat/completions — it is only served
# from /api/v1/images, which the server picks from the model id.
# Largest exact-16:9 preset is 2048x1152; 4096x2304 is rejected.
OPENROUTER_IMAGE_MODEL=openai/gpt-image-2.5-sunburst
# Text, vision and QC run on Kimi then Hyper. OpenRouter is images only.
# For 4K contact sheets instead (1835x1024 tiles, ~3.7x the cost):


# ---------------------------------------------------------------------------
# Object storage (RustFS, S3-compatible).
# Generated images are ~2.6 MB base64 each; they are uploaded here and referenced
# by URL so responses stay well under Vercel's 4.5 MB function body limit.
# ---------------------------------------------------------------------------
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
RUSTFS_REGION=us-east-1
# Must be reachable from the deployment. The internal Docker address
# (http://rustfs:9000) only resolves inside the homelab network.
RUSTFS_S3_ENDPOINT=https://s3.v1su4.dev
RUSTFS_PUBLIC_BASE_URL=https://s3.v1su4.dev
RUSTFS_FORCE_PATH_STYLE=true
TRAILERCRAFT_BUCKET=trailercraft

# Higgsfield — free daily credits, used for character-sheet panels.
# Create credentials at https://console.higgsfield.ai and copy the model id
# exactly as listed there.
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=
CHARACTER_SHEET_HF_MODEL=
# Field the model expects its reference image in (verify in the console).
CHARACTER_SHEET_HF_IMAGE_FIELD=image_url

# RustFS Media API gateway.
# Preferred over direct S3: it provisions the bucket on first write and applies the
# public-read/CORS policy. Modeled on pindeck/convex/mediaStorage.ts.
# The bucket comes from the token, so MEDIA_GATEWAY_BUCKET must also be sent on each
# upload or objects land in the token's own bucket instead of this app's.
MEDIA_GATEWAY_URL=https://media.v1su4.dev
MEDIA_GATEWAY_BUCKET=trailercraft
MEDIA_GATEWAY_USER_ID=trailercraft
MEDIA_GATEWAY_UPLOAD_PREFIX=media-uploads
MEDIA_GATEWAY_TOKEN=
